# Copy to .env and fill in. .env is in .gitignore: never commit real secrets.

# Database (the container creates it with these credentials the first time)
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT signing secret: at least 32 random characters (e.g. `openssl rand -base64 48`)
APP_JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more

# Admin created on the first start (leave the password empty to not create one)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Where the app is opened from (CORS) and the port on this machine
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Swagger UI at /swagger-ui.html (keep false in production)
APP_SWAGGER_ENABLED=false
