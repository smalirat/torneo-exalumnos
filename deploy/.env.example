# Copy to .env on the server and fill in. Never commit the real .env.

# Domain the app is served at (must point to this server's IP). Caddy gets the certificate for it.
DOMAIN=torneo.example.com

# Version to run: latest, or a CI tag like sha-14f7f04 (deploy.sh sets it)
TAG=latest

# Database (the container creates it with these credentials the first time)
DB_USERNAME=postgres
DB_PASSWORD=change-me
# The users the API uses (deploy/db-roles.sh): the owner runs the migrations, the app only reads and writes rows.
# Different passwords for each (openssl rand -base64 24)
DB_OWNER_PASSWORD=change-me-too
DB_APP_PASSWORD=change-me-as-well

# JWT signing secret: at least 32 random characters (openssl rand -base64 48). The API refuses to start with the
# example value below or an obviously weak one
APP_JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more

# Admin created on the first start (empty password: no admin is created)
APP_ADMIN_USERNAME=admin
# At least 12 characters (openssl rand -base64 18): the API refuses to start with a shorter one
APP_ADMIN_PASSWORD=

# Java memory. Leave it commented on a server with several GB (it takes 75% of the RAM).
# On a 1 GB machine (Oracle VM.Standard.E2.1.Micro) cap it so Postgres, nginx and Caddy fit too:
# JAVA_OPTS=-Xmx256m -Xss512k -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=32m -XX:+UseSerialGC -XX:TieredStopAtLevel=1

# Public demo with fictional data: true gives a "demo" admin, and the captains listed (comma-separated usernames),
# the password below, published in the README. Never for a league with real data. With it on, reset the demo every
# night (demo-reset.sh, see docs/deploy.md)
APP_DEMO_ENABLED=false
APP_DEMO_PASSWORD=
APP_DEMO_CAPTAINS=

# Grafana's "admin" user (openssl rand -base64 24). Grafana is only reachable through an SSH tunnel
GRAFANA_ADMIN_PASSWORD=

# Backups: days to keep on the server
KEEP_DAYS=14
# Copy outside the server: write-only upload URL from infra/oci_backup_bucket.py (empty: local only)
OFFSITE_URL=
# Ping URL of a healthchecks.io check (empty: no reports). It alerts by email if a night's backup does not report
HEALTHCHECK_URL=
